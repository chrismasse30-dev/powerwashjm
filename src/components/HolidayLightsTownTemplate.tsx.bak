import { useEffect, useState } from 'react';
import { Link } from 'react-router-dom';
import {
  Check, Phone, Mail, MapPin, Shield, Star, Clock, Lightbulb,
  ChevronRight, Package, Sparkles, Truck, Wrench, TreePine, Camera, X, HelpCircle, ChevronDown
} from 'lucide-react';
import HolidayLightsQuoteForm from '../components/HolidayLightsQuoteForm';
import { useBannerVisibility } from '../hooks/useBannerVisibility';
import { updatePageMeta, addMultipleStructuredData } from '../utils/seo';
import { HERO_IMAGES } from '../config/images';
import { holidayLightsTownsData, getNearbyTowns, type HolidayLightsFAQ } from '../data/holidayLightsTownsData';
import { galleryService, type GalleryPhoto } from '../services/galleryService';

interface HolidayLightsTownTemplateProps {
  townName: string;
  state: string;
  stateAbbr: string;
  zipCode: string;
  neighborhoods: string[];
  description: string;
  keywords: string;
  metaTitle: string;
  metaDescription: string;
  seoContent: string;
  mapEmbedUrl?: string;
  townSlug: string;
  faqs: HolidayLightsFAQ[];
  localHighlight?: string;
}

const WHY_CHOOSE = [
  { icon: Lightbulb, title: 'Commercial-Grade LEDs', desc: 'Custom-fit, commercial-grade LED lights rated for 50,000+ hours — brighter, more efficient, and longer-lasting than retail lights. No dangling cords.' },
  { icon: Shield, title: '$2M+ Liability Coverage', desc: 'Fully licensed and insured with over $2 million in liability coverage — your property is protected from start to finish.' },
  { icon: Wrench, title: 'Non-Damaging Installation', desc: 'We use professional roof clips — never staples or nails — so your shingles, gutters, and trim stay damage-free.' },
  { icon: Star, title: '100% Maintenance Guarantee', desc: 'If a bulb goes out or anything shifts during the season, we repair it within 24–48 hours at no extra charge.' },
];

const PROCESS_STEPS = [
  { icon: Lightbulb, title: 'Custom Holiday Lighting Design', desc: 'We assess your roofline, trees, and shrubs to create a custom lighting plan tailored to your property and vision.' },
  { icon: Sparkles, title: 'Commercial-Grade LEDs Provided', desc: 'All energy-efficient LED Christmas lights and custom-fit materials included — no retail store trips, no dangling wires.' },
  { icon: Wrench, title: 'Professional Installation', desc: 'Our insured crew installs everything with safe, non-damaging roof clips — never staples or nails — in a single visit.' },
  { icon: Phone, title: 'In-Season Maintenance Guarantee', desc: 'We monitor and repair your display throughout the season. Bulb out? We replace it within 24–48 hours at no extra charge.' },
  { icon: Truck, title: 'Takedown & Off-Season Storage', desc: 'After the holidays we carefully remove, pack, and store your lights — ready to reinstall next year at a reduced rate.' },
];

const RESIDENTIAL_SERVICES = [
  'Custom-fit roofline & gutter LED lighting', 'Tree & shrub wrapping with energy-efficient LEDs', 'Pathway & walkway accent lights',
  'Window & door frame accents — no dangling wires', 'Illuminated wreath & garland installation', 'Custom color schemes & designs',
];
const COMMERCIAL_SERVICES = [
  'Storefront & facade holiday lighting', 'Parking lot tree wrapping', 'Building outline roofline lighting',
  'Grand entrance holiday decor displays', 'Timer & automation setup', 'Large-scale custom commercial designs',
];

const GALLERY_IMAGES = [
  { src: '/homepagehousewithlights.jpeg', altTemplate: (t: string, s: string) => `Warm white roofline and peak holiday lights on a home in ${t}, ${s}`, w: 1200, h: 900 },
  { src: '/rihouselights.png', altTemplate: (t: string, s: string) => `Wrapped trees and shrub lighting for a ${t}, ${s} residence`, w: 1200, h: 900 },
  { src: '/lightteam.JPG', altTemplate: (t: string, s: string) => `J&M crew installing walkway and porch holiday lights near ${t}, ${s}`, w: 1200, h: 900 },
  { src: '/packages/garlandpackage.PNG', altTemplate: (t: string, s: string) => `Garland and lit wreath holiday package available in ${t}, ${s}`, w: 800, h: 600 },
  { src: '/packages/gingerbreadpackage.PNG', altTemplate: (t: string, s: string) => `Full roofline gingerbread-style holiday lighting for ${t}, ${s} homes`, w: 800, h: 600 },
  { src: '/packages/tinselpackage.png', altTemplate: (t: string, s: string) => `Tinsel accent holiday lighting package for properties in ${t}, ${s}`, w: 800, h: 600 },
];

function FAQAccordionItem({ question, answer }: { question: string; answer: string }) {
  const [isOpen, setIsOpen] = useState(false);
  return (
    <div className="border border-gray-200 rounded-lg overflow-hidden">
      <button
        onClick={() => setIsOpen(!isOpen)}
        className="w-full flex items-center justify-between p-5 text-left bg-gray-50 hover:bg-gray-100 transition-colors"
      >
        <span className="font-semibold text-gray-900 pr-4">{question}</span>
        <ChevronDown className={`w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200 ${isOpen ? 'rotate-180' : ''}`} />
      </button>
      {isOpen && (
        <div className="p-5 bg-white border-t border-gray-200">
          <p className="text-gray-700 leading-relaxed">{answer}</p>
        </div>
      )}
    </div>
  );
}

export default function HolidayLightsTownTemplate({
  townName, state, stateAbbr, zipCode, neighborhoods, description,
  keywords, metaTitle, metaDescription, seoContent, mapEmbedUrl, townSlug, faqs, localHighlight,
}: HolidayLightsTownTemplateProps) {
  const { getNavOffsetWithBreadcrumb } = useBannerVisibility();
  const [lightboxImage, setLightboxImage] = useState<{ src: string; alt: string } | null>(null);
  const [townPhotos, setTownPhotos] = useState<GalleryPhoto[]>([]);
  const canonicalUrl = `https://powerwashjm.com/holiday-lights/${townSlug}`;
  const pageSource = `Holiday Lights - ${townName}, ${stateAbbr}`;

  useEffect(() => {
    updatePageMeta({
      title: metaTitle,
      description: metaDescription,
      keywords,
      canonical: canonicalUrl,
      ogTitle: metaTitle,
      ogDescription: metaDescription,
      ogImage: '/rihouselightswithlogo.webp',
      imageAlt: `Professional Christmas light installation in ${townName}, ${stateAbbr} by J&M Holiday Lights`,
    });

    addMultipleStructuredData([

      {
        '@context': 'https://schema.org',
        '@type': 'Service',
        serviceType: 'Holiday Lighting Installation',
        name: `Christmas Light Installation in ${townName}, ${stateAbbr}`,
        description: metaDescription,
        provider: { '@id': 'https://powerwashjm.com/#business' },
        areaServed: {
          '@type': 'City',
          name: townName,
          containedInPlace: { '@type': 'State', name: state },
        },
        url: canonicalUrl,
        offers: {
          '@type': 'Offer',
          priceCurrency: 'USD',
          priceRange: '$500-$2500',
          availability: 'https://schema.org/InStock',
        },
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Holiday Lighting Services',
          itemListElement: [
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Residential Christmas Light Installation' } },
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Commercial Holiday Lighting' } },
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Holiday Light Removal & Storage' } },
          ],
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map(faq => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      },
    ]);
  }, [townName, stateAbbr, metaTitle, metaDescription, keywords, canonicalUrl, state, faqs]);

  useEffect(() => {
    galleryService.getPhotosByTown(townSlug).then(setTownPhotos).catch(() => {});
  }, [townSlug]);

  return (
    <div className="bg-white" style={getNavOffsetWithBreadcrumb()}>
      {/* Hero Section */}
      <section className="relative min-h-[520px] flex items-center overflow-hidden">
        <div
          className="absolute inset-0 bg-cover bg-center"
          style={{ backgroundImage: `url(${HERO_IMAGES.holidayLights})` }}
        />
        <div className="absolute inset-0 bg-gradient-to-br from-green-900/80 via-red-900/60 to-green-900/80" />
        <div className="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 py-20 text-center">
          <div className="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm rounded-full px-4 py-1.5 mb-6">
            <MapPin className="w-4 h-4 text-red-300" />
            <span className="text-sm text-white/90 font-medium">{townName}, {stateAbbr} {zipCode}</span>
          </div>
          <h1 className="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            <span className="block">Christmas Light Installation{' '}</span>
            <span className="text-red-300">in {townName}, {stateAbbr}</span>
          </h1>
          <p className="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto mb-8">
            Full-service holiday lighting experts — custom design, professional installation with energy-efficient LED Christmas lights, in-season maintenance, takedown and storage for homes and businesses in {townName}, {stateAbbr}.
          </p>
          <div className="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#quote" className="inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-semibold px-8 py-3.5 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl">
              Get a Free Quote <ChevronRight className="w-5 h-5" />
            </a>
            <a href="tel:+14015950726" className="inline-flex items-center justify-center gap-2 bg-white/15 hover:bg-white/25 backdrop-blur-sm text-white font-semibold px-8 py-3.5 rounded-lg border border-white/30 transition-all duration-200">
              <Phone className="w-5 h-5" /> (401) 595-0726
            </a>
          </div>
        </div>
      </section>

      {/* Why Choose J&M */}
      <section className="py-16 sm:py-20 bg-gradient-to-br from-slate-50 to-green-50">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 className="font-heading text-3xl sm:text-4xl font-bold text-green-900 text-center mb-4">
            Why {townName} Homeowners Choose J&M Holiday Lighting Experts
          </h2>
          <p className="text-gray-600 text-center max-w-2xl mx-auto mb-12">
            Trusted outdoor Christmas light installers serving {townName} and all of {stateAbbr} — professional holiday decor services with commercial-grade LEDs, safe non-damaging roof clips, and a full maintenance guarantee.
          </p>
          <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {WHY_CHOOSE.map(({ icon: Icon, title, desc }) => (
              <div key={title} className="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow duration-200 border border-green-100">
                <div className="w-12 h-12 bg-red-50 rounded-lg flex items-center justify-center mb-4">
                  <Icon className="w-6 h-6 text-red-600" />
                </div>
                <h3 className="font-heading font-semibold text-gray-900 mb-2">{title}</h3>
                <p className="text-sm text-gray-600 leading-relaxed">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Our Holiday Lights Gallery */}
      <section className="py-16 sm:py-20">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center mb-12">
            <div className="inline-flex items-center gap-2 bg-green-100 text-green-800 rounded-full px-4 py-1.5 text-sm font-medium mb-4">
              <Camera className="w-4 h-4" />
              Our Work in Action
            </div>
            <h2 className="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
              Holiday Light Installations Near {townName}
            </h2>
            <p className="text-lg text-gray-600 max-w-2xl mx-auto">
              See the quality and craftsmanship we bring to every home in the {townName} area. 
              From subtle elegance to dazzling displays, we do it all.
            </p>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
            {GALLERY_IMAGES.map((img, idx) => {
              const alt = img.altTemplate(townName, stateAbbr);
              return (
                <button
                  key={idx}
                  onClick={() => setLightboxImage({ src: img.src, alt })}
                  className="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
                >
                  <img
                    src={img.src}
                    alt={alt}
                    width={img.w}
                    height={img.h}
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    {...(idx === 0 ? { fetchPriority: 'high' as const } : {})}
                    className="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-110"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                  <div className="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <p className="text-white text-sm font-medium drop-shadow-lg">{alt}</p>
                  </div>
                </button>
              );
            })}
          </div>

          <div className="text-center mt-8">
            <Link
              to="/holiday-lights#quote"
              className="inline-flex items-center gap-2 text-green-700 hover:text-green-900 font-semibold transition-colors"
            >
              Want this for your {townName} home? Get a free quote
              <ChevronRight className="w-4 h-4" />
            </Link>
          </div>
        </div>
      </section>

      {/* Lightbox */}
      {lightboxImage && (
        <div
          className="fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4"
          onClick={() => setLightboxImage(null)}
        >
          <button
            onClick={() => setLightboxImage(null)}
            className="absolute top-4 right-4 text-white/80 hover:text-white transition-colors"
            aria-label="Close"
          >
            <X className="w-8 h-8" />
          </button>
          <img
            src={lightboxImage.src}
            alt={lightboxImage.alt}
            className="max-w-full max-h-[85vh] rounded-lg object-contain"
            onClick={(e) => e.stopPropagation()}
          />
          <p className="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/90 text-sm font-medium bg-black/50 backdrop-blur-sm px-4 py-2 rounded-full">
            {lightboxImage.alt}
          </p>
        </div>
      )}

      {/* Town-Specific Project Photos from Gallery */}
      {townPhotos.length > 0 && (
        <section className="py-16 sm:py-20 bg-gray-50">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="text-center mb-12">
              <div className="inline-flex items-center gap-2 text-green-700 font-semibold text-sm uppercase tracking-wider mb-3">
                <Camera className="w-4 h-4" />
                Recent Installations
              </div>
              <h2 className="font-heading text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
                Holiday Light Installations Across Rhode Island
              </h2>
              <p className="text-lg text-gray-600 max-w-2xl mx-auto">
                See examples of our recent holiday lighting work for homeowners throughout Rhode Island.
              </p>
            </div>
            <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {townPhotos.map((photo, idx) => {
                const photoAlts = [
                  `Roofline holiday lights on a ${townName}, ${stateAbbr} home`,
                  `Wrapped trees with holiday lights near ${townName}, ${stateAbbr}`,
                  `Porch and walkway holiday lighting in ${townName}, ${stateAbbr}`,
                  `LED holiday light display for a ${townName}, ${stateAbbr} residence`,
                ];
                const photoAlt = photo.title || photoAlts[idx % photoAlts.length];
                return (
                <button
                  key={photo.id}
                  onClick={() => setLightboxImage({ src: photo.image_url, alt: photoAlt })}
                  className="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
                >
                  <img
                    src={photo.image_url}
                    alt={photoAlt}
                    width={800}
                    height={600}
                    loading="lazy"
                    className="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-110"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                  {photo.title && (
                    <div className="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      <p className="text-white text-sm font-medium drop-shadow-lg">{photo.title}</p>
                    </div>
                  )}
                </button>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* Town-Specific Content */}
      <section className="py-16 sm:py-20">
        <div className="max-w-4xl mx-auto px-4 sm:px-6">
          <h2 className="font-heading text-3xl sm:text-4xl font-bold text-green-900 mb-6">
            Professional Christmas Light & Holiday Lighting in {townName}, {state}
          </h2>
          <div className="prose prose-lg max-w-none text-gray-700 mb-10 leading-relaxed">
            <p>{description}</p>
          </div>
          {seoContent && (
            <div className="prose prose-lg max-w-none text-gray-600 mb-10 leading-relaxed" dangerouslySetInnerHTML={{ __html: seoContent }} />
          )}
          {localHighlight && (
            <div className="bg-amber-50 border border-amber-200 rounded-xl p-6 sm:p-8 mb-10">
              <div className="flex items-start gap-3">
                <MapPin className="w-5 h-5 text-amber-600 mt-1 shrink-0" />
                <div>
                  <h3 className="font-semibold text-gray-900 mb-2">Local Insight: {townName}</h3>
                  <p className="text-gray-700 leading-relaxed">{localHighlight}</p>
                </div>
              </div>
            </div>
          )}
          {neighborhoods.length > 0 && (
            <div className="bg-green-50 border border-green-200 rounded-xl p-6 sm:p-8">
              <h3 className="font-heading text-xl font-semibold text-green-900 mb-4 flex items-center gap-2">
                <MapPin className="w-5 h-5 text-green-700" />
                Neighborhoods We Serve in {townName}
              </h3>
              <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
                {neighborhoods.map((n) => (
                  <div key={n} className="flex items-center gap-2 text-gray-700">
                    <Check className="w-4 h-4 text-green-600 flex-shrink-0" />
                    <span>{n}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      {/* Services Offered */}
      <section className="py-16 sm:py-20 bg-gradient-to-br from-red-900 via-green-900 to-red-800 text-white">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 className="font-heading text-3xl sm:text-4xl font-bold text-center mb-4">
            Professional Holiday Decor Services in {townName}
          </h2>
          <p className="text-white/80 text-center max-w-2xl mx-auto mb-12">
            Residential and commercial Christmas light installation, custom holiday lighting design, lit trees and shrubs, illuminated wreaths and garlands — everything your {townName} property needs.
          </p>
          <div className="grid md:grid-cols-2 gap-8">
            {[
              { title: 'Residential Lighting', items: RESIDENTIAL_SERVICES, icon: TreePine },
              { title: 'Commercial Lighting', items: COMMERCIAL_SERVICES, icon: Lightbulb },
            ].map(({ title, items, icon: Icon }) => (
              <div key={title} className="bg-white/10 backdrop-blur-sm rounded-xl p-6 sm:p-8 border border-white/20">
                <div className="flex items-center gap-3 mb-6">
                  <div className="w-10 h-10 bg-red-500/30 rounded-lg flex items-center justify-center">
                    <Icon className="w-5 h-5 text-red-200" />
                  </div>
                  <h3 className="font-heading text-xl font-semibold">{title}</h3>
                </div>
                <ul className="space-y-3">
                  {items.map((item) => (
                    <li key={item} className="flex items-center gap-3 text-white/90">
                      <Check className="w-4 h-4 text-green-400 flex-shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* 5-Step Process */}
      <section className="py-16 sm:py-20 bg-gradient-to-br from-slate-50 to-green-50">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 className="font-heading text-3xl sm:text-4xl font-bold text-green-900 text-center mb-4">
            How Our Holiday Light Installation Works
          </h2>
          <p className="text-gray-600 text-center max-w-2xl mx-auto mb-12">
            Custom holiday lighting design, professional installation, in-season maintenance, takedown and storage — we handle every detail so you can enjoy a stunning display worry-free.
          </p>
          <div className="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
            {PROCESS_STEPS.map(({ icon: Icon, title, desc }, i) => (
              <div key={title} className="relative text-center">
                <div className="w-14 h-14 bg-green-700 rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
                  <Icon className="w-6 h-6 text-white" />
                </div>
                <div className="absolute top-7 left-1/2 w-full h-px bg-green-200 -z-10 hidden lg:block" style={{ display: i === PROCESS_STEPS.length - 1 ? 'none' : undefined }} />
                <span className="inline-block text-xs font-bold text-green-700 bg-green-100 rounded-full px-2.5 py-0.5 mb-2">Step {i + 1}</span>
                <h3 className="font-heading font-semibold text-gray-900 mb-1 text-sm">{title}</h3>
                <p className="text-xs text-gray-600 leading-relaxed">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* FAQ Section */}
      {faqs.length > 0 && (
        <section className="py-16 sm:py-20 bg-white">
          <div className="max-w-4xl mx-auto px-4 sm:px-6">
            <div className="text-center mb-10">
              <div className="inline-flex items-center gap-2 bg-green-100 text-green-800 text-sm font-medium px-4 py-2 rounded-full mb-4">
                <HelpCircle className="w-4 h-4" />
                Frequently Asked Questions
              </div>
              <h2 className="font-heading text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
                Christmas Light Installation FAQ for {townName}, {stateAbbr}
              </h2>
              <p className="text-gray-600 max-w-2xl mx-auto">
                Everything you need to know about professional holiday light installation in {townName}, {stateAbbr}.
              </p>
            </div>
            <div className="space-y-4">
              {faqs.map((faq, index) => (
                <FAQAccordionItem key={index} question={faq.question} answer={faq.answer} />
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Quote Form */}
      <section id="quote" className="py-16 sm:py-20 bg-gradient-to-br from-green-900 via-red-900 to-green-800">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-10">
            <h2 className="font-heading text-3xl sm:text-4xl font-bold text-white mb-4">
              Get a Free Holiday Lighting Estimate in {townName}
            </h2>
            <p className="text-white/80 max-w-2xl mx-auto">
              Tell us about your property and we will create a custom holiday lighting plan just for you.
            </p>
            <div className="flex flex-wrap justify-center gap-4 mt-6">
              {[
                { icon: Shield, label: 'Licensed & Insured' },
                { icon: Lightbulb, label: 'Commercial-Grade LEDs' },
                { icon: Wrench, label: '100% Maintenance Guarantee' },
              ].map((badge) => (
                <div key={badge.label} className="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 border border-white/20">
                  <badge.icon className="w-4 h-4 text-green-400 flex-shrink-0" />
                  <span className="text-white text-sm font-medium">{badge.label}</span>
                </div>
              ))}
            </div>
          </div>
          <HolidayLightsQuoteForm submitEmail="sales@powerwashjm.com" pageSource={pageSource} />
        </div>
      </section>

      {/* GEO/AEO: AI-Optimized Summary for AI Search Engines */}
      <section className="py-16 sm:py-20 bg-white">
        <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 className="font-heading text-3xl font-bold text-gray-900 mb-6">
            Best Christmas Light Installer in {townName}, {stateAbbr}
          </h2>
          <div className="prose prose-lg max-w-none text-gray-700 space-y-4">
            <p>
              <strong>J&M Power Washing and Holiday Lights</strong> is a top-rated professional Christmas light installation company
              serving {townName}, {state} and surrounding areas. We provide full-service holiday lighting including custom design
              consultation, professional installation with commercial-grade energy-efficient LED Christmas lights, in-season maintenance
              with a 24–48 hour repair guarantee, and complete takedown and off-season storage.
            </p>
            <p>
              Our outdoor Christmas light installers use only non-damaging roof clips (never staples or nails) and custom-fit
              roofline lights with no dangling wires. Every installation is fully insured with $2M+ liability coverage. We serve
              both residential and commercial properties throughout {townName} including neighborhoods like{' '}
              {neighborhoods.slice(0, 3).join(', ')}.
            </p>
            <p>
              Residential Christmas light installation in {townName} typically ranges from $500 to $2,500 depending on home size and
              design complexity. To get a free estimate, call <a href="tel:+14015950726" className="text-green-700 font-semibold">(401) 595-0726</a> or
              fill out our online quote form above.
            </p>
          </div>
        </div>
      </section>

      {/* Nearby Holiday Lighting Towns - Internal Cross-Links */}
      <section className="py-12 bg-gray-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h3 className="text-2xl font-bold text-gray-900 mb-6 text-center">
            Holiday Lighting Service Areas Near {townName}
          </h3>
          <div className="flex flex-wrap justify-center gap-3">
            {getNearbyTowns(townSlug)
              .map(t => (
                <Link
                  key={t.slug}
                  to={`/holiday-lights/${t.slug}`}
                  className="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-700 hover:bg-green-50 hover:border-green-300 hover:text-green-800 transition-all"
                >
                  {t.name}, {t.stateAbbr}
                </Link>
              ))}
          </div>
          <div className="text-center mt-6">
            <Link
              to="/holiday-lights"
              className="text-green-700 font-semibold hover:text-green-900 transition-colors"
            >
              View all {holidayLightsTownsData.length} holiday lighting service areas →
            </Link>
          </div>
        </div>
      </section>

      {/* Map & Service Area */}
      <section className="py-16 sm:py-20">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="grid md:grid-cols-2 gap-10 items-center">
            <div>
              <h2 className="font-heading text-3xl font-bold text-green-900 mb-4">
                Serving {townName} & Surrounding Areas
              </h2>
              <p className="text-gray-600 mb-6 leading-relaxed">
                Based in Johnston, RI, J&M Power Washing and Holiday Lights proudly serves {townName} and
                neighboring communities throughout {state}. Our team travels to your location for a seamless,
                stress-free experience.
              </p>
              <div className="space-y-3 mb-8">
                <a href="tel:+14015950726" className="flex items-center gap-3 text-gray-700 hover:text-green-700 transition-colors">
                  <Phone className="w-5 h-5 text-green-700" /> (401) 595-0726
                </a>
                <a href="mailto:sales@powerwashjm.com" className="flex items-center gap-3 text-gray-700 hover:text-green-700 transition-colors">
                  <Mail className="w-5 h-5 text-green-700" /> sales@powerwashjm.com
                </a>
                <div className="flex items-center gap-3 text-gray-700">
                  <MapPin className="w-5 h-5 text-green-700" /> Johnston, RI 02919
                </div>
              </div>
              <Link to="/holiday-lights" className="inline-flex items-center gap-2 text-green-700 hover:text-green-800 font-semibold transition-colors">
                View All Holiday Lighting Services <ChevronRight className="w-4 h-4" />
              </Link>
            </div>
            <div className="rounded-xl overflow-hidden shadow-lg border border-gray-200 aspect-video bg-gray-100">
              {mapEmbedUrl ? (
                <iframe
                  src={mapEmbedUrl}
                  width="100%"
                  height="100%"
                  style={{ border: 0, minHeight: 300 }}
                  allowFullScreen
                  loading="lazy"
                  referrerPolicy="no-referrer-when-downgrade"
                  title={`Map of ${townName}, ${stateAbbr}`}
                />
              ) : (
                <div className="w-full h-full flex flex-col items-center justify-center text-gray-400 min-h-[300px]">
                  <MapPin className="w-10 h-10 mb-2" />
                  <span className="text-sm">{townName}, {stateAbbr}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    </div>
  );
}