{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:navigation",
    "build": "CI=false vite build && npm run prerender && npm run prerender:blogs",
    "build:no-prerender": "vite build",
    "build:skip-check": "vite build && npm run postbuild",
    "prerender": "node prerender-ssr.mjs",
    "prerender:blogs": "node prerender-blog-posts.mjs",
    "prerender:basic": "node prerender.mjs",
    "validate:navigation": "node scripts/validate-navigation.cjs",
    "verify:seo": "node verify-seo.mjs",
    "verify:schemas": "node verify-no-duplicate-schemas.mjs",
    "verify:images": "node check-binary-images.mjs",
    "restore:images": "node restore-binary-images.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.2.1",
    "web-vitals": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "terser": "^5.44.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
